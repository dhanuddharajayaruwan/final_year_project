# ─── Cylon Force Gym - Frontend Environment Variables ───────────────────────
# Vite exposes only variables prefixed with VITE_ to the client.
# Do NOT commit this file to version control (add .env to .gitignore).

# ─── Backend API ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000

# ─── App Info ────────────────────────────────────────────────────────────────
VITE_APP_NAME=Cylon Force Gym
VITE_APP_VERSION=1.0.4

# ─── Payment Gateway (e.g. Stripe or PayHere) ────────────────────────────────
# Add your publishable key here (never put secret keys in frontend .env)
VITE_PAYMENT_PUBLIC_KEY=your_payment_public_key_here

# ─── Google Maps (if used for gym location) ──────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

VITE_CHATBOT_API_URL=http://localhost:8080
